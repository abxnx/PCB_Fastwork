(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad r420_420
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 420000)
            (height 420000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad c420
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 210000
            (pt 0 0)
          )
        )
      )
      (pad c555
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 277500
            (pt 0 0)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack r420_420h314
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 157000
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad r420_420))
          (noconnect (pad r420_420))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r420_420))
          (noconnect (pad r420_420))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad r420_420))
          (noconnect (pad r420_420))
        )
        (padSet (footLayer Inner)
          (clearance (pad r420_420))
          (connect (pad r420_420))
          (noconnect (pad r420_420))
        )
        (padSet (footLayer Bottom)
          (connect (pad r420_420))
          (noconnect (pad r420_420))
        )
      )
      (padstack c420h314
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 157000
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c420))
          (noconnect (pad c420))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c420))
          (noconnect (pad c420))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c420))
          (noconnect (pad c420))
        )
        (padSet (footLayer Inner)
          (clearance (pad c420))
          (connect (pad c420))
          (noconnect (pad c420))
        )
        (padSet (footLayer Bottom)
          (connect (pad c420))
          (noconnect (pad c420))
        )
      )
      (padstack c555h370
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 185000
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c555))
          (noconnect (pad c555))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c555))
          (noconnect (pad c555))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c555))
          (noconnect (pad c555))
        )
        (padSet (footLayer Inner)
          (clearance (pad c555))
          (connect (pad c555))
          (noconnect (pad c555))
        )
        (padSet (footLayer Bottom)
          (connect (pad c555))
          (noconnect (pad c555))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "RAPC712TRP22X"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -450000 705000
                        (width 10000)
                      )
                      (pt 450000 705000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 450000 705000
                        (width 10000)
                      )
                      (pt 450000 -745000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 450000 -745000
                        (width 10000)
                      )
                      (pt -450000 -745000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -450000 -745000
                        (width 10000)
                      )
                      (pt -450000 705000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer CompArea-Top)
              (area
                (geometry
                  (surface
                    (outlineWidth 0)
                    (fillWidth 0)
                    (fillAngle 0.000000)
                    (vertex
                    (pt 790000 1002500)
                    (pt 790000 -845000)
                    (pt -550000 -845000)
                    (pt -550000 1002500)
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -400000 705000
                        (width 20000)
                      )
                      (pt -450000 700000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -450000 700000
                        (width 20000)
                      )
                      (pt -450000 -745000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -450000 -745000
                        (width 20000)
                      )
                      (pt 450000 -745000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 450000 -745000
                        (width 20000)
                      )
                      (pt 450000 0
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -500000 0
                        (width 10000)
                      )
                      (pt -500000 0
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt -500000 0
                            (width 10000)
                          )
                        )
                        (center -1073741824 0)
                        (end
                          (pt -510000 0
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt -510000 0
                            (width 10000)
                          )
                        )
                        (center 1073741824 0)
                        (end
                          (pt -500000 0
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin 1
            (pt 0 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 0)
                  (angle 90)
                  (padstackGroup default (padstack r420_420h314))
                )
              )
            )
          )
          (pin 2
            (pt 480000 325000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 480000 325000)
                  (angle 90)
                  (padstackGroup default (padstack c420h314))
                )
              )
            )
          )
          (pin 3
            (pt 0 625000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 625000)
                  (angle 90)
                  (padstackGroup default (padstack c555h370))
                )
              )
            )
          )
        ); End of toeprint
        (propertyS accurateShape RAPC712TRP22X.stp)
      ); End of footprint
    ); End of footprints
  );  End of footprintContainer
); End of ftf

